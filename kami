#!/usr/bin/env bash
# kami — run the node in THIS terminal (no autostart needed). Ctrl+C stops it.
#
#     ./kami
#
# Starts the sensor loggers, the voice loop (if ~/voice-venv exists), and the
# web chat in the foreground. With autostart set (set_autostart.sh on), control
# those instead:   ./start_kami.sh   /   ./stop_kami.sh
set -euo pipefail
cd "$(dirname "${BASH_SOURCE[0]}")"

IP="$(hostname -I | awk '{print $1}')"

if systemctl is-active --quiet solarturtle-web 2>/dev/null; then
  echo "The node is already running as a service (autostart)."
  echo "  Chat page: http://$IP:8080"
  echo "  Stop it:   ./stop_kami.sh"
  exit 0
fi

if ! curl -sf http://127.0.0.1:11434/api/tags >/dev/null 2>&1; then
  echo "Ollama is not answering — trying to start it..."
  sudo systemctl start ollama || true
fi

PIDS=()
cleanup() {
  for p in ${PIDS[@]+"${PIDS[@]}"}; do
    kill "$p" 2>/dev/null || true
  done
}
trap cleanup EXIT INT TERM

python3 sensors_boot.py & PIDS+=($!)
echo "sensor loggers: running"

if [ -x "$HOME/voice-venv/bin/python" ]; then
  "$HOME/voice-venv/bin/python" voice/talk.py --serve & PIDS+=($!)
  echo "voice loop:     running (enable the mic from the chat page)"
fi

echo
echo "Chat page:  http://$IP:8080   (Ctrl+C stops everything)"
echo
python3 web_server.py
